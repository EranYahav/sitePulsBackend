generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  role           String   @default("supervisor") // "supervisor" | "manager"
  isAdmin        Boolean  @default(false) // app-level administrator (manages users)
  tier           Int      @default(0)     // 0 = free/limited; >0 = paying tier (gates access later)
  companyName    String?
  companyLogoUrl        String?  // branded client portal header (E3)
  companyLogoCloudinaryId String?
  mobileNumber   String?
  phoneNumber    String?
  whatsappNumber String?
  createdAt      DateTime @default(now())

  ownedProjects    Project[]        @relation("ProjectOwner")
  managedProjects  ProjectManager[]
  reports          Report[]
  refreshTokens    RefreshToken[]
  approvedChecks   Check[]          @relation("CheckApprover")
  resources        Resource[]
  uploadedMedia    Media[]          @relation("MediaUploader")
}

model Project {
  id              String    @id @default(uuid())
  name            String
  description     String    @default("")
  ownerId         String
  projectTypeId   String?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner       User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  projectType ProjectType?     @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  managers    ProjectManager[]
  reports     Report[]
  defects     Defect[]
  stages      Stage[]
  resources   Resource[]
  shareLink   ShareLink?
  locations   Location[]
  media       Media[]
}

model ProjectManager {
  projectId  String
  managerId  String
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  manager User    @relation(fields: [managerId], references: [id])

  @@id([projectId, managerId])
}

model Report {
  id          String   @id @default(uuid())
  projectId   String
  authorId    String
  stageId     String?
  notes       String
  title       String?  // AI-extracted short title (max 5 words)
  status      String   @default("pending") // "pending" | "generating" | "done" | "failed"
  reportData  String?  // JSON string of structured AI report
  pdfPublicId String?  // Cloudinary public_id for signed URL re-issue
  clientPublished Boolean @default(false) // inspector controls when a report appears on the client portal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id])
  author  User         @relation(fields: [authorId], references: [id])
  stage   Stage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)
  images  ReportImage[]
  job     ReportJob?
}

model ReportImage {
  id           String @id @default(uuid())
  reportId     String
  cloudinaryId String
  url          String

  report Report @relation(fields: [reportId], references: [id])
}

model ReportJob {
  id          String    @id @default(uuid())
  reportId    String    @unique
  status      String    @default("queued") // "queued" | "processing" | "done" | "failed"
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  report Report @relation(fields: [reportId], references: [id])
}

model Defect {
  id           String    @id @default(uuid())
  projectId    String
  stageId      String?
  title        String
  photoUrl     String
  cloudinaryId String
  urgency      String    // "high" | "medium" | "low"
  domain       String    // "electrical" | "plumbing" | "drywall" | "tiling" | "paint" | "structure" | "other"
  description  String?
  tradesperson String?
  reminderDate DateTime?
  status         String    @default("open") // "open" | "assigned" | "resolved"
  trackingNotes  String?
  clientVisible        Boolean  @default(false) // defects hidden from client by default; inspector opts in
  resolvedPhotoUrl     String?  // before/after: the "after" photo captured at resolution (E2)
  resolvedCloudinaryId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  check   Check?
}

model Stage {
  id            String    @id @default(uuid())
  projectId     String
  title         String
  description   String?
  color         String    @default("#6366f1")
  durationWeeks Int?
  startDate     DateTime?
  endDate       DateTime?
  order         Int
  dependsOnId   String?
  templateId    String?
  completedAt     DateTime? // inspector marks a stage complete; this is the milestone event
  clientPublished Boolean   @default(false) // milestone appears on the portal only when published (E1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependsOn Stage?   @relation("StageDependency", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents Stage[] @relation("StageDependency")
  template  StageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  reports   Report[]
  defects   Defect[]
  checks    Check[]
  media     Media[]
}

model Resource {
  id          String   @id @default(uuid())
  projectId   String
  label       String   // max 100 chars (enforced in route via Zod)
  url         String   // TEXT (no DB cap); http/https only, max 8192 enforced in route via Zod
  kind        String   @default("file") // "file" | "folder" — folder shows a folder icon
  isPinned    Boolean  @default(false)  // max 3 pinned per project (enforced in route)
  order       Int      // manual sort, ascending; ties break on createdAt
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([projectId])
}

model DefectDomain {
  id        String   @id @default(uuid())
  key       String   @unique
  nameHe    String
  nameEn    String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShareLink {
  id           String    @id @default(uuid())
  projectId    String    @unique // one live link per project; revoke + recreate to rotate the token
  token        String    @unique // >=128-bit unguessable; resolved by the public portal middleware
  revoked      Boolean   @default(false)
  expiresAt    DateTime? // auto-expiry (S2); null = no expiry
  lastViewedAt DateTime? // read-receipt for the inspector (E4)
  viewCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([token])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ProjectType {
  id          String   @id @default(uuid())
  // Per-inspector catalog ownership (corrected Approach A). Bare string sentinel,
  // NOT a relation: "__system__" = global default (provisioning source); otherwise
  // the owning supervisor's User.id. The app has no user.findMany, so an FK buys
  // nothing. A supervisor's effective catalog = system rows whose key is neither
  // overridden nor tombstoned by one of their owned rows, UNION their non-hidden rows.
  ownerId     String   @default("__system__")
  key         String
  nameHe      String
  nameEn      String?
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  // originId: for an override (fork-on-edit), the system ProjectType.id it forked from.
  originId    String?
  // isHidden: tombstone marker. A deleted default = owned row, same key, isHidden=true, no subtree.
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())

  stageTemplates StageTemplate[]
  projects       Project[]

  // key is unique per owner (was globally @unique). All ownerId values are non-null
  // so the compound unique and findUnique({ ownerId_key }) behave correctly on SQLite.
  @@unique([ownerId, key])
  @@index([ownerId])
}

model StageTemplate {
  id                   String   @id @default(uuid())
  projectTypeId        String
  title                String
  description          String?
  color                String   @default("#6366f1")
  defaultDurationWeeks Int?
  order                Int

  projectType    ProjectType     @relation(fields: [projectTypeId], references: [id], onDelete: Cascade)
  checkTemplates CheckTemplate[]
  stages         Stage[]

  @@index([projectTypeId])
}

model CheckTemplate {
  id              String  @id @default(uuid())
  stageTemplateId String
  text            String
  order           Int
  isRequired      Boolean @default(true)

  stageTemplate StageTemplate @relation(fields: [stageTemplateId], references: [id], onDelete: Cascade)
  checks        Check[]

  @@index([stageTemplateId])
}

// ─── Media Bank ──────────────────────────────────────────────────────────────
// Photos & videos organized by Location (room ∪ area) × construction Stage.
// Stage is auto-inferred from the project timeline at upload (user-confirmed per
// batch); Location is optional (building-level media has none). See
// ~/.gstack/projects/site-pulse/EranYahav-unknown-design-*.md

model Location {
  id        String   @id @default(uuid())
  projectId String
  name      String                       // "מטבח", "גג", "יסודות"
  kind      String   @default("room")    // "room" | "area" — drives grouping + seed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media[]

  @@index([projectId])
}

model Media {
  id           String   @id @default(uuid())
  projectId    String
  stageId      String?                    // auto-inferred; user picks if parallel/undated
  locationId   String?                    // room/area; null = building-level
  type         String                     // "image" | "video" — UI discriminator
  cloudinaryId String
  url          String
  resourceType String                     // cloudinary resource_type; drives delete
  caption      String?
  tradesperson String?                    // free text, reuses Defect pattern
  capturedAt   DateTime                    // client per-file timestamp; defaults to upload time
  uploadedById String
  createdAt    DateTime @default(now())

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage      Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  uploadedBy User      @relation("MediaUploader", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([stageId])
  @@index([locationId])
}

model Check {
  id           String    @id @default(uuid())
  stageId      String
  templateId   String?
  text         String
  order        Int
  isRelevant   Boolean   @default(true)

  status       String    @default("pending") // "pending" | "approved" | "failed"
  approvedAt   DateTime?
  approvedById String?
  notes        String?

  photoUrl     String?
  cloudinaryId String?

  defectId     String?   @unique

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stage      Stage          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  template   CheckTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  approvedBy User?          @relation("CheckApprover", fields: [approvedById], references: [id])
  defect     Defect?        @relation(fields: [defectId], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([status])
}
